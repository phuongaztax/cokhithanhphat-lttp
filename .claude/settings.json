{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**/*.puml)",
      "Edit(./docs/**)",
      "Bash(java -jar *plantuml*.jar *)",
      "Bash(dot -V)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
